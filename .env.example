NODE_ENV=production
DOCKER_NETWORK_NAME=real_estate_network

CORE_IMAGE=ghcr.io/<owner>/<backend-repo>/core:latest
SCHEDULER_IMAGE=ghcr.io/<owner>/<backend-repo>/scheduler:latest

CORE_PORT=3001
CORE_PUBLISHED_PORT=3001
CORE_MEMORY_LIMIT=512m
SCHEDULER_PORT=3002
SCHEDULER_PUBLISHED_PORT=3002
SCHEDULER_MEMORY_LIMIT=768m
SCHEDULER_SHM_SIZE=512mb
SCHEDULER_ENABLE_DOCS=no
BATDONGSAN_HEADLESS=true
BATDONGSAN_CONCURRENCY=1

POSTGRES_DB=realestate
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PUBLISHED_PORT=5432
POSTGRES_MEMORY_LIMIT=512m

DATABASE_URL=postgres://myuser:mypassword@postgres:5432/realestate?schema=base

REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=myredispassword
REDIS_TTL=
REDIS_BIND_IP=127.0.0.1
REDIS_PUBLISHED_PORT=6379
REDIS_MEMORY_LIMIT=128m

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=30000
AI_SERVICE_RETRIES=2
AI_SERVICE_INGEST_TIMEOUT=0
AI_SERVICE_INGEST_RETRIES=0
PLANNING_BATCH_INGEST_CONCURRENCY=5
PLANNING_INGEST_QUEUE_CONCURRENCY=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_BUCKET_NAME=
