generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// ENUMS
// -------------------------------------------------------

enum StatusLogAction {
  INACTIVE
  ACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PostType {
  SALE
  RENT
  OTHER
}

enum FurnitureStatus {
  UNFURNISHED
  PARTLY_FURNISHED
  FULLY_FURNISHED
}

enum LegalStatus {
  FREEHOLD
  LEASEHOLD
  RED_BOOK
  PINK_BOOK
  OTHER
}

enum DepositStatus {
  PENDING
  AUTHORIZED
  CONFIRMED
  REFUNDED
  CANCELLED
  EXPIRED
  FAILED
}

enum RoleType {
  ADMIN
  MANAGER
  USER
  AGENT
}

enum SystemPermissionType {
  MANAGE_USERS
  MANAGE_ROLES
  MANAGE_PAYMENT
  MANAGE_PROPERTY
  MANAGE_POST
  MANAGE_CATEGORY
  MANAGE_AMENITIES
  MANAGE_LEADS
  MANAGE_CHAT
  MANAGE_APPOINTMENT
}

enum OtpPurpose {
  RESET_PASSWORD
}

enum AmenityCategory {
  INTERIOR // Nội thất (máy lạnh, tủ âm tường...)
  EXTERIOR // Ngoài trời/cảnh quan (ban công, sân vườn...)
  SECURITY // An ninh (camera, thẻ từ...)
  ACCESSIBILITY // Tiếp cận/khuyết tật (thang máy, ram dốc...)
  COMMUNITY // Tiện ích cộng đồng (hồ bơi, phòng gym...)
  PARKING // Đỗ xe (ô tô, xe máy, sạc EV...)
  KITCHEN // Bếp (bếp âm, máy rửa chén...)
  BATHROOM // Phòng tắm (bồn tắm, vách kính...)
  ENTERTAINMENT // Giải trí (phòng chiếu, karaoke...)
  ENERGY // Tiết kiệm năng lượng (solar, cách nhiệt...)
  SMART_HOME // Nhà thông minh (khóa điện tử, cảm biến...)
  PET_FRIENDLY // Thân thiện thú cưng
  BUSINESS // Phù hợp kinh doanh (mặt tiền, biển hiệu...)
}

enum UtilityCategory {
  COMMERCIAL_SHOPPING // TTTM/siêu thị/cửa hàng
  HEALTHCARE // Bệnh viện/phòng khám/nhà thuốc
  EDUCATION // Trường học/mẫu giáo
  TRANSPORT // Bến xe/ga/tàu điện
  PARK_PLAZA // Công viên/quảng trường
  FINANCIAL // Ngân hàng/ATM
  GOVERNMENT // Cơ quan hành chính
  ENTERTAINMENT // Giải trí/rạp phim
  DINING // Ăn uống/nhà hàng/quán
  SPORTS // Thể thao/gyms/sân bãi
  RELIGIOUS // Chùa/nhà thờ
  FUEL // Cây xăng/sạc EV
  ACCOMMODATION // Khách sạn/lưu trú
  PARKING // Bãi đỗ xe
  OTHER // Khác
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

// -------------------------------------------------------
// USERS & RBAC
// -------------------------------------------------------

model User {
  id        Int       @id @default(autoincrement()) @map("id")
  roleId    Int       @map("role_id")
  email     String    @unique
  name      String?
  password  String
  phone     String?
  lastLogin DateTime? @map("last_login")
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdPosts     Post[]      @relation("PostCreatedBy")
  approvedPosts    Post[]      @relation("PostApprovedBy")
  rejectedPosts    Post[]      @relation("PostRejectedBy")
  propertiesOwned  Property[]  @relation("PropertyOwner")
  otps             Otp[]
  favorites        Favorites[]
  depositsAsBuyer  Deposit[]   @relation("DepositBuyer")
  depositsAsSeller Deposit[]   @relation("DepositSeller")

  leadsAsBuyer Lead[] @relation("LeadBuyer")
  leadsAsAgent Lead[] @relation("LeadAgent")

  conversationsAsBuyer Conversation[]       @relation("ConvBuyer")
  conversationsAsAgent Conversation[]       @relation("ConvAgent")
  messages             Message[]            @relation("MsgSender")
  appointmentsAsBuyer  Appointment[]        @relation("ApptBuyer")
  appointmentsAsAgent  Appointment[]        @relation("ApptAgent")
  reports              Report[]             @relation("ReportReporter")
  auditLogs            AuditLog[]
  savedSearches        SavedSearch[]
  passwordResetToken   PasswordResetToken[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement()) @map("id")
  name        RoleType @unique
  description String?

  users       User[]
  permissions RolesPermissions[]

  @@map("roles")
}

model Permission {
  id   Int                  @id @default(autoincrement()) @map("id")
  name SystemPermissionType @unique

  roles RolesPermissions[]

  @@map("permissions")
}

model RolesPermissions {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permissions")
}

model Otp {
  id         Int         @id @default(autoincrement()) @map("id")
  code       String
  userId     Int         @map("user_id")
  purpose    OtpPurpose?
  expireTime DateTime    @map("expire_time")
  used       Boolean     @default(false)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -------------------------------------------------------
// LOCATION
// -------------------------------------------------------

model Province {
  id   Int    @id @default(autoincrement()) @map("id")
  name String

  districts  District[]
  properties Property[]
  utilities  Utility[]

  @@map("provinces")
}

model District {
  id         Int    @id @default(autoincrement()) @map("id")
  name       String
  provinceId Int    @map("province_id")

  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  wards      Ward[]
  properties Property[]
  utilities  Utility[]

  @@index([provinceId])
  @@map("districts")
}

model Ward {
  id         Int    @id @default(autoincrement()) @map("id")
  name       String
  districtId Int    @map("district_id")

  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  properties Property[]
  utilities  Utility[]

  @@index([districtId])
  @@map("wards")
}

// -------------------------------------------------------
// CATEGORIES
// -------------------------------------------------------

model PropertyCategory {
  id                  Int       @id @default(autoincrement()) @map("category_id")
  categoryName        String    @unique @map("category_name")
  categoryDescription String?   @default("") @map("category_description")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  properties Property[]

  @@map("categories")
}

// -------------------------------------------------------
// PROPERTIES
// -------------------------------------------------------

model Property {
  id              Int              @id @default(autoincrement()) @map("id")
  title           String
  description     String?          @db.Text
  price           Decimal          @db.Decimal(18, 2)
  area            Decimal?         @db.Decimal(10, 2)
  bedroomNumber   Int?
  toiletNumber    Int?
  floorNumber     Int?
  parking         Boolean?
  orientation     String?
  frontage        Decimal?         @db.Decimal(6, 2)
  roadWidth       Decimal?         @db.Decimal(6, 2)
  furnitureStatus FurnitureStatus? @map("furniture_status")
  legalStatus     LegalStatus?     @map("legal_status")
  yearBuilt       Int?             @map("year_built")
  lat             Decimal?         @db.Decimal(9, 6)
  lon             Decimal?         @db.Decimal(9, 6)
  location        String?
  categoryId      Int              @map("category_id")
  ownerId         Int              @map("owner_id")
  wardId          Int?             @map("ward_id")
  districtId      Int?             @map("district_id")
  provinceId      Int?             @map("province_id")
  status          Status           @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  // Relations
  category PropertyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner    User             @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  ward     Ward?            @relation(fields: [wardId], references: [id], onDelete: SetNull)
  district District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  province Province?        @relation(fields: [provinceId], references: [id], onDelete: SetNull)

  images            PropertyImage[]
  propertyAmenities PropertyAmenity[]
  posts             Post[]
  propertyUtilities PropertyUtility[]

  @@index([status])
  @@index([provinceId, districtId, wardId])
  @@index([price])
  @@index([area])
  @@index([bedroomNumber])
  @@index([ownerId])
  @@map("properties")
}

model PropertyImage {
  id         Int      @id @default(autoincrement()) @map("id")
  propertyId Int      @map("property_id")
  imageUrl   String   @map("image_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, imageUrl])
  @@index([propertyId])
  @@map("property_images")
}

// -------------------------------------------------------
// AMENITIES
// -------------------------------------------------------

model Amenity {
  id        Int              @id @default(autoincrement()) @map("id")
  name      String           @unique
  category  AmenityCategory?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  id         Int       @id @default(autoincrement()) @map("id")
  propertyId Int       @map("property_id")
  amenityId  Int       @map("amenity_id")
  deletedAt  DateTime? @map("deleted_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

// -------------------------------------------------------
// UTILITIES (poi xung quanh)
// -------------------------------------------------------

model PropertyUtility {
  id         Int @id @default(autoincrement()) @map("id")
  propertyId Int @map("property_id")
  utilityId  Int @map("utility_id")

  distanceM   Decimal? @map("distance_m") @db.Decimal(8, 2) // khoảng cách theo mét
  travelTimeS Int?     @map("travel_time_s") // thời gian di chuyển (giây)
  isPrimary   Boolean? @default(false) @map("is_primary")
  note        String?

  deletedAt DateTime? @map("deleted_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utility  Utility  @relation(fields: [utilityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, utilityId])
  @@index([utilityId])
  @@map("property_utilities")
}

model Utility {
  id              Int             @id @default(autoincrement()) @map("id")
  utilityCategory UtilityCategory @map("utility_category")
  utilityName     String?         @map("utility_name")
  lat             Decimal?        @db.Decimal(9, 6)
  lon             Decimal?        @db.Decimal(9, 6)
  location        String?
  provinceId      Int?            @map("province_id")
  districtId      Int?            @map("district_id")
  wardId          Int?            @map("ward_id")
  deletedAt       DateTime?       @map("deleted_at")

  // quan hệ địa lý giữ nguyên
  province Province? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  ward     Ward?     @relation(fields: [wardId], references: [id], onDelete: SetNull)

  properties PropertyUtility[]

  @@index([utilityCategory])
  @@index([provinceId, districtId, wardId])
  @@map("utilities")
}

// -------------------------------------------------------
// POSTS & FAVORITES (Moderation)
// -------------------------------------------------------

model Post {
  id           Int        @id @default(autoincrement()) @map("id")
  propertyId   Int        @map("property_id")
  postTitle    String     @map("post_title")
  postType     PostType?  @map("post_type")
  postContent  String?    @map("post_content") @db.Text
  postStatus   PostStatus @default(DRAFT) @map("post_status")
  approvedById Int?       @map("approved_by_id")
  approvedAt   DateTime?  @map("approved_at")
  rejectedById Int?       @map("rejected_by_id")
  rejectReason String?    @map("reject_reason")
  publishedAt  DateTime?  @map("published_at")
  createdById  Int        @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Relations
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("PostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy User?    @relation("PostRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  favorites     Favorites[]
  deposits      Deposit[]
  leads         Lead[]
  conversations Conversation[]
  appointments  Appointment[]
  slugs         PostSlug[]
  reports       Report[]

  @@index([postStatus])
  @@index([createdById])
  @@index([propertyId])
  @@index([publishedAt])
  @@map("posts")
}

model Favorites {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    Int       @map("user_id")
  postId    Int       @map("post_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("favorite_list")
}

// -------------------------------------------------------
// DEPOSITS (Đặt cọc)
// -------------------------------------------------------

model Deposit {
  id             Int           @id @default(autoincrement()) @map("id")
  postId         Int           @map("post_id")
  buyerId        Int           @map("buyer_id")
  sellerId       Int           @map("seller_id")
  amount         Decimal       @db.Decimal(18, 2)
  status         DepositStatus @default(PENDING)
  provider       String?
  transactionRef String?       @unique @map("transaction_ref")
  holdExpiresAt  DateTime?     @map("hold_expires_at")
  paidAt         DateTime?     @map("paid_at")
  confirmedAt    DateTime?     @map("confirmed_at")
  releasedAt     DateTime?     @map("released_at")
  note           String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyer  User @relation("DepositBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("DepositSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("deposits")
}

// -------------------------------------------------------
// LEADS / CHAT / APPOINTMENTS
// -------------------------------------------------------

enum LeadStatus {
  NEW // Mới tạo, chưa xử lý
  CONTACTED // Đã liên hệ
  FOLLOW_UP // Đang theo dõi / chờ phản hồi
  NEGOTIATION // Đang thương lượng
  CONVERTED // Đã chuyển đổi thành giao dịch
  LOST // Mất lead / không tiềm năng
  ARCHIVED // Lưu trữ, không hoạt động
}

model Lead {
  id        Int        @id @default(autoincrement()) @map("id")
  postId    Int        @map("post_id")
  buyerId   Int?       @map("buyer_id")
  agentId   Int?       @map("agent_id")
  name      String?
  email     String?
  phone     String?
  message   String?    @db.Text
  note      String?    @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyer User? @relation("LeadBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  agent User? @relation("LeadAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([buyerId])
  @@index([agentId])
  @@index([status])
  @@map("leads")
}

model Conversation {
  id            Int       @id @default(autoincrement()) @map("id")
  postId        Int?      @map("post_id")
  buyerId       Int?      @map("buyer_id")
  agentId       Int?      @map("agent_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  post  Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  buyer User? @relation("ConvBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  agent User? @relation("ConvAgent", fields: [agentId], references: [id], onDelete: SetNull)

  messages Message[]

  @@unique([postId, buyerId, agentId])
  @@index([postId])
  @@index([buyerId])
  @@index([agentId])
  @@map("conversations")
}

model Message {
  id             Int       @id @default(autoincrement()) @map("id")
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  content        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MsgSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Appointment {
  id          Int                @id @default(autoincrement()) @map("id")
  postId      Int                @map("post_id")
  buyerId     Int                @map("buyer_id")
  agentId     Int?               @map("agent_id") // Add agentId later so that it is optinal in db -> required in service
  scheduledAt DateTime           @map("scheduled_at")
  location    String?
  status      AppointmentStatus? @default(SCHEDULED)
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyer User  @relation("ApptBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  agent User? @relation("ApptAgent", fields: [agentId], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([buyerId])
  @@index([agentId])
  @@index([scheduledAt])
  @@map("appointments")
}

// -------------------------------------------------------
// CONTENT / SEO / QA
// -------------------------------------------------------

enum ReportStatus {
  PENDING // Báo cáo mới, chưa xử lý
  UNDER_REVIEW // Đang được kiểm tra
  ACTION_TAKEN // Đã xử lý (đã xóa bài, cảnh cáo, v.v.)
  REJECTED // Báo cáo bị từ chối (không hợp lệ)
  RESOLVED // Đã giải quyết hoàn tất
}

model Report {
  id         Int          @id @default(autoincrement()) @map("id")
  postId     Int          @map("post_id")
  reporterId Int?         @map("reporter_id")
  reason     String?
  detail     String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model AuditLog {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    Int?     @map("user_id")
  action    String
  entity    String?
  entityId  Int?     @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SavedSearch {
  id          Int      @id @default(autoincrement()) @map("id")
  userId      Int      @map("user_id")
  name        String?
  filtersJson Json     @map("filters_json")
  notifyEmail Boolean  @default(false) @map("notify_email")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model PostSlug {
  id        Int      @id @default(autoincrement()) @map("id")
  postId    Int      @map("post_id")
  slug      String   @unique
  isCurrent Boolean  @default(true) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([isCurrent])
  @@map("post_slugs")
}

model LogAction {
  id        BigInt          @id @default(autoincrement())
  url       String          @db.Text
  method    String          @db.VarChar(10)
  body      String          @db.Text
  ip        String          @db.VarChar(45)
  query     String          @db.Text
  now       DateTime        @default(now())
  data      String          @db.Text
  timeCall  Int             @map("time_call")
  status    StatusLogAction
  userId    BigInt?         @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("log_actions")
}
