generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// ENUMS
// -------------------------------------------------------

enum StatusLogAction {
  INACTIVE
  ACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PostType {
  SALE
  RENT
  OTHER
}

enum FurnitureStatus {
  UNFURNISHED
  PARTLY_FURNISHED
  FULLY_FURNISHED
}

enum LegalStatus {
  FREEHOLD
  LEASEHOLD
  RED_BOOK
  PINK_BOOK
  OTHER
}

enum DepositStatus {
  PENDING
  AUTHORIZED
  CONFIRMED
  REFUNDED
  CANCELLED
  EXPIRED
  FAILED
}

enum RoleType {
  ADMIN
  MANAGER
  USER
}

enum SystemPermissionType {
  MANAGE_USERS
  MANAGE_ROLES
  MANAGE_PAYMENT
  MANAGE_PROPERTY
  MANAGE_POST
  MANAGE_CATEGORY
  MANAGE_AMENITIES
}

enum OtpPurpose {
  RESET_PASSWORD
}

enum AmenityCategory {
  INTERIOR // Nội thất (máy lạnh, tủ âm tường...)
  EXTERIOR // Ngoài trời/cảnh quan (ban công, sân vườn...)
  SECURITY // An ninh (camera, thẻ từ...)
  ACCESSIBILITY // Tiếp cận/khuyết tật (thang máy, ram dốc...)
  COMMUNITY // Tiện ích cộng đồng (hồ bơi, phòng gym...)
  PARKING // Đỗ xe (ô tô, xe máy, sạc EV...)
  KITCHEN // Bếp (bếp âm, máy rửa chén...)
  BATHROOM // Phòng tắm (bồn tắm, vách kính...)
  ENTERTAINMENT // Giải trí (phòng chiếu, karaoke...)
  ENERGY // Tiết kiệm năng lượng (solar, cách nhiệt...)
  SMART_HOME // Nhà thông minh (khóa điện tử, cảm biến...)
  PET_FRIENDLY // Thân thiện thú cưng
  BUSINESS // Phù hợp kinh doanh (mặt tiền, biển hiệu...)
}

enum UtilityCategory {
  COMMERCIAL_SHOPPING // TTTM/siêu thị/cửa hàng
  HEALTHCARE // Bệnh viện/phòng khám/nhà thuốc
  EDUCATION // Trường học/mẫu giáo
  TRANSPORT // Bến xe/ga/tàu điện
  PARK_PLAZA // Công viên/quảng trường
  FINANCIAL // Ngân hàng/ATM
  GOVERNMENT // Cơ quan hành chính
  ENTERTAINMENT // Giải trí/rạp phim
  DINING // Ăn uống/nhà hàng/quán
  SPORTS // Thể thao/gyms/sân bãi
  RELIGIOUS // Chùa/nhà thờ
  FUEL // Cây xăng/sạc EV
  ACCOMMODATION // Khách sạn/lưu trú
  PARKING // Bãi đỗ xe
  OTHER // Khác
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

// -------------------------------------------------------
// USERS & RBAC
// -------------------------------------------------------

model User {
  user_id   Int       @id @default(autoincrement())
  role_id   Int
  email     String    @unique
  name      String?
  password  String
  phone     String?
  lastLogin DateTime?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  // Relations
  role                 Role                 @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  createdPosts         Post[]               @relation("PostCreatedBy")
  approvedPosts        Post[]               @relation("PostApprovedBy")
  rejectedPosts        Post[]               @relation("PostRejectedBy")
  propertiesOwned      Property[]           @relation("PropertyOwner")
  otps                 Otp[]
  favorites            FavoriteList[]
  depositsAsBuyer      Deposit[]            @relation("DepositBuyer")
  depositsAsSeller     Deposit[]            @relation("DepositSeller")
  leads                Lead[]               @relation("LeadBuyer")
  conversationsAsBuyer Conversation[]       @relation("ConvBuyer")
  conversationsAsAgent Conversation[]       @relation("ConvAgent")
  messages             Message[]            @relation("MsgSender")
  appointmentsAsBuyer  Appointment[]        @relation("ApptBuyer")
  appointmentsAsAgent  Appointment[]        @relation("ApptAgent")
  reports              Report[]             @relation("ReportReporter")
  auditLogs            AuditLog[]
  savedSearches        SavedSearch[]
  PasswordResetToken   PasswordResetToken[]

  @@map("users")
}

model Role {
  role_id     Int      @id @default(autoincrement())
  name        RoleType @unique
  description String?

  users       User[]
  permissions RolesPermissions[]

  @@map("roles")
}

model Permission {
  permission_id Int                  @id @default(autoincrement())
  name          SystemPermissionType @unique

  roles RolesPermissions[]

  @@map("permissions")
}

model RolesPermissions {
  role_id       Int
  permission_id Int

  // Relations
  role       Role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("roles_permissions")
}

model Otp {
  otp_id     Int         @id @default(autoincrement())
  code       String
  user_id    Int
  purpose    OtpPurpose?
  expireTime DateTime
  used       Boolean     @default(false)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("otp")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  user_id   Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([expiresAt])
}

// -------------------------------------------------------
// LOCATION
// -------------------------------------------------------

model Province {
  province_id Int    @id @default(autoincrement())
  name        String

  districts  District[]
  properties Property[]
  utilities  Utility[]

  @@map("provinces")
}

model District {
  district_id Int    @id @default(autoincrement())
  name        String
  province_id Int

  province   Province   @relation(fields: [province_id], references: [province_id], onDelete: Cascade)
  wards      Ward[]
  properties Property[]
  utilities  Utility[]

  @@index([province_id])
  @@map("districts")
}

model Ward {
  ward_id     Int    @id @default(autoincrement())
  name        String
  district_id Int

  district   District   @relation(fields: [district_id], references: [district_id], onDelete: Cascade)
  properties Property[]
  utilities  Utility[]

  @@index([district_id])
  @@map("wards")
}

// -------------------------------------------------------
// CATEGORIES
// -------------------------------------------------------

model PropertyCategory {
  category_id          Int       @id @default(autoincrement())
  category_name        String    @unique
  category_description String?   @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  deletedAt            DateTime?

  properties Property[]

  @@map("categories")
}

// -------------------------------------------------------
// PROPERTIES
// -------------------------------------------------------

model Property {
  property_id     Int              @id @default(autoincrement())
  title           String
  description     String?          @db.Text
  price           Decimal          @db.Decimal(18, 2)
  area            Decimal?         @db.Decimal(10, 2)
  bedroomNumber   Int?
  toiletNumber    Int?
  floorNumber     Int?
  parking         Boolean?
  orientation     String?
  frontage        Decimal?         @db.Decimal(6, 2)
  roadWidth       Decimal?         @db.Decimal(6, 2)
  furnitureStatus FurnitureStatus?
  legalStatus     LegalStatus?
  yearBuilt       Int?
  lat             Decimal?         @db.Decimal(9, 6)
  lon             Decimal?         @db.Decimal(9, 6)
  location        String?
  category_id     Int
  owner_id        Int
  ward_id         Int?
  district_id     Int?
  province_id     Int?
  status          Status           @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  deletedAt       DateTime?

  // Relations
  category PropertyCategory @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  owner    User             @relation("PropertyOwner", fields: [owner_id], references: [user_id], onDelete: Restrict)
  ward     Ward?            @relation(fields: [ward_id], references: [ward_id], onDelete: SetNull)
  district District?        @relation(fields: [district_id], references: [district_id], onDelete: SetNull)
  province Province?        @relation(fields: [province_id], references: [province_id], onDelete: SetNull)

  images            PropertyImage[]
  PropertyAmenities PropertyAmenity[]
  posts             Post[]
  PropertyUtilities PropertyUtility[]

  @@index([status])
  @@index([province_id, district_id, ward_id])
  @@index([price])
  @@index([area])
  @@index([bedroomNumber])
  @@index([owner_id])
  @@map("properties")
}

model PropertyImage {
  image_id    Int      @id @default(autoincrement())
  property_id Int
  imageUrl    String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  property Property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)

  @@unique([property_id, imageUrl])
  @@index([property_id])
  @@map("property_images")
}

// -------------------------------------------------------
// AMENITIES
// -------------------------------------------------------

model Amenity {
  amenity_id Int              @id @default(autoincrement())
  name       String           @unique
  category   AmenityCategory?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt
  deletedAt  DateTime?

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  property_id Int
  amenity_id  Int
  deletedAt   DateTime?

  property Property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenity_id], references: [amenity_id], onDelete: Cascade)

  @@id([property_id, amenity_id])
  @@map("property_amenities")
}

// -------------------------------------------------------
// UTILITIES (poi xung quanh)
// -------------------------------------------------------

model PropertyUtility {
  property_id Int
  utility_id  Int

  distance_m    Decimal? @db.Decimal(8, 2) // khoảng cách theo mét
  travel_time_s Int? // thời gian di chuyển (giây)
  is_primary    Boolean? @default(false)
  note          String?

  deletedAt DateTime?

  property Property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  utility  Utility  @relation(fields: [utility_id], references: [utility_id], onDelete: Cascade)

  @@id([property_id, utility_id])
  @@index([utility_id])
  @@map("property_utilities")
}

model Utility {
  utility_id       Int             @id @default(autoincrement())
  utility_category UtilityCategory
  utility_name     String?
  lat              Decimal?        @db.Decimal(9, 6)
  lon              Decimal?        @db.Decimal(9, 6)
  location         String?
  province_id      Int?
  district_id      Int?
  ward_id          Int?
  deletedAt        DateTime?

  // quan hệ địa lý giữ nguyên
  province Province? @relation(fields: [province_id], references: [province_id], onDelete: SetNull)
  district District? @relation(fields: [district_id], references: [district_id], onDelete: SetNull)
  ward     Ward?     @relation(fields: [ward_id], references: [ward_id], onDelete: SetNull)

  properties PropertyUtility[]

  @@index([utility_category])
  @@index([province_id, district_id, ward_id])
  @@map("utilities")
}

// -------------------------------------------------------
// POSTS & FAVORITES (Moderation)
// -------------------------------------------------------

model Post {
  post_id      Int        @id @default(autoincrement())
  property_id  Int
  postTitle    String
  postType     PostType?
  postContent  String?    @db.Text
  postStatus   PostStatus @default(DRAFT)
  approvedById Int?
  approvedAt   DateTime?
  rejectedById Int?
  rejectReason String?
  publishedAt  DateTime?
  createdById  Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  deletedAt    DateTime?

  // Relations
  property   Property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  createdBy  User     @relation("PostCreatedBy", fields: [createdById], references: [user_id], onDelete: Restrict)
  approvedBy User?    @relation("PostApprovedBy", fields: [approvedById], references: [user_id], onDelete: SetNull)
  rejectedBy User?    @relation("PostRejectedBy", fields: [rejectedById], references: [user_id], onDelete: SetNull)

  favorites     FavoriteList[]
  deposits      Deposit[]
  leads         Lead[]
  conversations Conversation[]
  appointments  Appointment[]
  slugs         PostSlug[]
  reports       Report[]

  @@index([postStatus])
  @@index([createdById])
  @@index([property_id])
  @@index([publishedAt])
  @@map("posts")
}

model FavoriteList {
  favorite_id Int      @id @default(autoincrement())
  user_id     Int
  post_id     Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
  @@map("favorite_list")
}

// -------------------------------------------------------
// DEPOSITS (Đặt cọc)
// -------------------------------------------------------

model Deposit {
  deposit_id     Int           @id @default(autoincrement())
  post_id        Int
  buyerId        Int
  sellerId       Int
  amount         Decimal       @db.Decimal(18, 2)
  status         DepositStatus @default(PENDING)
  provider       String?
  transactionRef String?       @unique
  holdExpiresAt  DateTime?
  paidAt         DateTime?
  confirmedAt    DateTime?
  releasedAt     DateTime?
  note           String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  post   Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  buyer  User @relation("DepositBuyer", fields: [buyerId], references: [user_id], onDelete: Restrict)
  seller User @relation("DepositSeller", fields: [sellerId], references: [user_id], onDelete: Restrict)

  @@index([post_id])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("deposits")
}

// -------------------------------------------------------
// LEADS / CHAT / APPOINTMENTS
// -------------------------------------------------------

enum LeadStatus {
  NEW // Mới tạo, chưa xử lý
  CONTACTED // Đã liên hệ
  FOLLOW_UP // Đang theo dõi / chờ phản hồi
  NEGOTIATION // Đang thương lượng
  CONVERTED // Đã chuyển đổi thành giao dịch
  LOST // Mất lead / không tiềm năng
  ARCHIVED // Lưu trữ, không hoạt động
}

model Lead {
  lead_id   Int        @id @default(autoincrement())
  post_id   Int
  buyerId   Int?
  name      String?
  email     String?
  phone     String?
  message   String?    @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  post  Post  @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  buyer User? @relation("LeadBuyer", fields: [buyerId], references: [user_id], onDelete: SetNull)

  @@index([post_id])
  @@index([buyerId])
  @@index([status])
  @@map("leads")
}

model Conversation {
  conversation_id Int       @id @default(autoincrement())
  post_id         Int?
  buyerId         Int?
  agentId         Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  deletedAt       DateTime?

  post  Post? @relation(fields: [post_id], references: [post_id], onDelete: SetNull)
  buyer User? @relation("ConvBuyer", fields: [buyerId], references: [user_id], onDelete: SetNull)
  agent User? @relation("ConvAgent", fields: [agentId], references: [user_id], onDelete: SetNull)

  messages Message[]

  @@unique([post_id, buyerId, agentId])
  @@index([post_id])
  @@index([buyerId])
  @@index([agentId])
  @@map("conversations")
}

model Message {
  message_id      Int       @id @default(autoincrement())
  conversation_id Int
  senderId        Int
  content         String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  deletedAt       DateTime?

  conversation Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  sender       User         @relation("MsgSender", fields: [senderId], references: [user_id])

  @@index([conversation_id])
  @@index([senderId])
  @@map("messages")
}

model Appointment {
  appointment_id Int                @id @default(autoincrement())
  post_id        Int
  buyerId        Int
  sellerId       Int
  scheduledAt    DateTime
  location       String?
  status         AppointmentStatus? @default(SCHEDULED)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  deletedAt      DateTime?

  post   Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  buyer  User @relation("ApptBuyer", fields: [buyerId], references: [user_id], onDelete: Restrict)
  seller User @relation("ApptAgent", fields: [sellerId], references: [user_id], onDelete: Restrict)

  @@index([post_id])
  @@index([buyerId])
  @@index([sellerId])
  @@index([scheduledAt])
  @@map("appointments")
}

// -------------------------------------------------------
// CONTENT / SEO / QA
// -------------------------------------------------------

enum ReportStatus {
  PENDING // Báo cáo mới, chưa xử lý
  UNDER_REVIEW // Đang được kiểm tra
  ACTION_TAKEN // Đã xử lý (đã xóa bài, cảnh cáo, v.v.)
  REJECTED // Báo cáo bị từ chối (không hợp lệ)
  RESOLVED // Đã giải quyết hoàn tất
}

model Report {
  report_id  Int          @id @default(autoincrement())
  post_id    Int
  reporterId Int?
  reason     String?
  detail     String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  post     Post  @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  reporter User? @relation("ReportReporter", fields: [reporterId], references: [user_id], onDelete: SetNull)

  @@index([post_id])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model AuditLog {
  audit_id  Int      @id @default(autoincrement())
  user_id   Int?
  action    String
  entity    String?
  entityId  Int?
  payload   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SavedSearch {
  savedSearch_id Int      @id @default(autoincrement())
  user_id        Int
  name           String?
  filtersJson    Json
  notifyEmail    Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("saved_searches")
}

model PostSlug {
  slug_id   Int      @id @default(autoincrement())
  post_id   Int
  slug      String   @unique
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)

  @@index([post_id])
  @@index([isCurrent])
  @@map("post_slugs")
}

model LogAction {
  id        BigInt          @id @default(autoincrement())
  url       String          @db.Text
  method    String          @db.VarChar(10)
  body      String          @db.Text
  ip        String          @db.VarChar(45)
  query     String          @db.Text
  now       DateTime        @default(now())
  data      String          @db.Text
  timeCall  Int
  status    StatusLogAction
  user_id   BigInt?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@map("log_actions")
}
